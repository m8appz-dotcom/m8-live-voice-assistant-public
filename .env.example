# Server-only voice configuration. Never put service credentials in EXPO_PUBLIC values.
M8LIVE_PROVIDER=spark
SPARK_LLM_URL=
SPARK_LLM_MODEL=
SPARK_ASR_URL=
SPARK_ASR_KIND=nemo
SPARK_ASR_MODEL=
SPARK_TTS_URL=
SPARK_TTS_TOKEN=

# Optional legacy rollback: set M8LIVE_PROVIDER=gemini explicitly.
GEMINI_API_KEY=
BRIDGE_AUTH_TOKEN=
BRIDGE_ACCESS_PASSWORD=
BRIDGE_SESSION_SECRET=
BRIDGE_SESSION_TTL_MS=43200000
BRIDGE_ALLOWED_ORIGINS=https://live.m8apps.com,http://localhost:8081,http://localhost:19006,http://localhost:3000

# Optional feature gates
BRIDGE_ENABLE_OPENCLAW_ROUTES=0
BRIDGE_ENABLE_NOTIFICATION_ROUTES=0
BRIDGE_ALLOWED_TELEGRAM_TARGET=
M8LIVE_PUBLIC_URL=https://live.m8apps.com/live
M8LIVE_DEVICE_REGISTRATION_TOKEN=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_CALL_MODULE_PATH=
OPENCLAW_BRIDGE_SESSION_KEY=agent:main:m8-live-bridge
OPENCLAW_BRIDGE_AGENT_ID=main
OPENCLAW_BRIDGE_MODEL=openai-codex/gpt-5.4
M8LIVE_OPENCLAW_DISPATCH_TIMEOUT_MS=120000
M8LIVE_OPENCLAW_SEND_RETRIES=4
M8LIVE_OPENCLAW_RETRY_BASE_DELAY_MS=1500

# Optional Telegram full-read connector.
# Uses optional deps tdl + prebuilt-tdlib; run connectors/telegram-tdlib-bridge.mjs and point the proxy at it.
M8LIVE_TELEGRAM_TDLIB_BRIDGE_URL=http://127.0.0.1:7311
M8LIVE_TELEGRAM_TDLIB_BRIDGE_TOKEN=
TELEGRAM_TDLIB_BRIDGE_PORT=7311
TELEGRAM_TDLIB_BRIDGE_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_TDLIB_DATABASE_DIRECTORY=.tdlib/telegram-db
TELEGRAM_TDLIB_FILES_DIRECTORY=.tdlib/telegram-files

# Optional Gmail full-read connector.
# Create an OAuth Web Client in Google Cloud and set callback to the public bridge callback URL.
M8LIVE_GMAIL_OAUTH_CLIENT_ID=
M8LIVE_GMAIL_OAUTH_CLIENT_SECRET=
M8LIVE_GMAIL_OAUTH_REDIRECT_URI=https://live.m8apps.com/api/messages/gmail/oauth/callback
M8LIVE_GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly
M8LIVE_GMAIL_TOKEN_STORE_PATH=.gmail-oauth.json
# Alternative private-host mode: get Gmail-scoped tokens from local gcloud user auth.
M8LIVE_GMAIL_ACCESS_TOKEN_COMMAND=

# Public app config (not secret unless you deliberately pair it with M8LIVE_DEVICE_REGISTRATION_TOKEN for private builds)
EXPO_PUBLIC_PROXY_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_M8LIVE_DEVICE_REGISTRATION_TOKEN=
