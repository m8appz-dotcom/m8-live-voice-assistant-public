# Secrets moved to vault.json.gpg (gemini_live section)
# Use: $vault = gpg ... | ConvertFrom-Json; .gemini_live.api_key
# This file left as placeholder - app should read from vault or env vars at runtime

# Required for the live bridge
GEMINI_API_KEY=
BRIDGE_AUTH_TOKEN=
BRIDGE_ACCESS_PASSWORD=
BRIDGE_SESSION_SECRET=
BRIDGE_SESSION_TTL_MS=43200000
BRIDGE_ALLOWED_ORIGINS=https://live.m8apps.com,http://localhost:8081,http://localhost:19006,http://localhost:3000

# Optional feature gates
BRIDGE_ENABLE_OPENCLAW_ROUTES=1
BRIDGE_ENABLE_NOTIFICATION_ROUTES=0
BRIDGE_ALLOWED_TELEGRAM_TARGET=
M8LIVE_PUBLIC_URL=https://live.m8apps.com/live
M8LIVE_DEVICE_REGISTRATION_TOKEN=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_CALL_MODULE_PATH=
OPENCLAW_BRIDGE_SESSION_KEY=agent:coder:m8-live-bridge
OPENCLAW_BRIDGE_AGENT_ID=coder
OPENCLAW_BRIDGE_MODEL=openai-codex/gpt-5.4

# Public app config (not secret unless you deliberately pair it with M8LIVE_DEVICE_REGISTRATION_TOKEN for private builds)
EXPO_PUBLIC_PROXY_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_M8LIVE_DEVICE_REGISTRATION_TOKEN=
